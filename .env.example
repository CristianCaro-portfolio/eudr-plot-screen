# Copy to .env if you want to change the defaults. Nothing here is a credential:
# every data source used by this project is public and needs no account.

# Folder for downloaded embeddings, labels and the LanceDB store (about 5 GB for the default areas)
PLOTSCREEN_DATA_DIR=./data

# Set to 1 to read the embeddings through the Source Cooperative gateway instead of S3 directly
GEOTESSERA_VIA_GATEWAY=0
